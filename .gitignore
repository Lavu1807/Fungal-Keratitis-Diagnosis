# ===========================
# Python
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/

# ===========================
# IDE / Editor
# ===========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===========================
# Data — images & generated files
# ===========================
# Raw images (too large for git, keep locally)
**/data/raw/**
!**/data/raw/.gitkeep

# Processed images (generated by preprocess_mN.py)
**/data/processed/**
!**/data/processed/.gitkeep

# Augmented images (generated by augment_mN.py)
**/data/augmented/**
!**/data/augmented/.gitkeep

# Extracted features (generated by feature_extract_mN.py)
**/data/features/**
!**/data/features/.gitkeep

# Classification results (generated by classify_*.py)
**/data/results/**
!**/data/results/.gitkeep

# ===========================
# Misc
# ===========================
*.log
*.tmp
*.bak
